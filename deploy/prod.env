# Окружение prod — единственный источник настроек окружения.
# Workflow копирует этот файл на сервер как .env, поэтому домен и прочие
# значения задаются здесь и в workflow больше не дублируются.
PROJECT_NAME=standup
ENVIRONMENT=prod
DOMAIN=standup.izhdigital.ru
TZ=Europe/Samara
CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=public
PULL_POLICY=always
